{
  "name": "ci-cd-test-app",
  "version": "1.0.0",
  "description": "Deliberately vulnerable User & Task Management REST API for CI/CD pipeline testing",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "./node_modules/.bin/jest --coverage --forceExit"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.0.0",
    "express": "4.17.1",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
